# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# This bot is read-only: it never needs a private key or seed phrase. Do not put one here.

# --- Discord webhooks (Server Settings > Integrations > Webhooks). One channel per category.
# DEFAULT is used by every category without its own webhook.
# With neither, the category runs in dry-run mode: logged and stored, not sent.
DISCORD_WEBHOOK_DEFAULT=
DISCORD_WEBHOOK_NEW_TOKEN=
DISCORD_WEBHOOK_SYSTEM=
# Used from Phase 2 onward:
DISCORD_WEBHOOK_SMART_MONEY_BUY=
DISCORD_WEBHOOK_SMART_MONEY_SELL=
DISCORD_WEBHOOK_WHALE=
DISCORD_WEBHOOK_BREAKING_NEWS=
DISCORD_WEBHOOK_TRENDING=
DISCORD_WEBHOOK_HIGH_OPPORTUNITY=
DISCORD_WEBHOOK_HIGH_RISK=
# Viral World Radar reports (npm run viral:post -- <report.json>)
DISCORD_WEBHOOK_VIRAL=

# --- Pump.fun launch alerts: all | filtered | off
# Pump.fun produces several launches per minute; "filtered" alerts only launches where the
# creator's first buy >= PUMPFUN_MIN_DEV_BUY_SOL, or the name/symbol contains a keyword.
PUMPFUN_NEW_TOKEN_ALERTS=filtered
PUMPFUN_MIN_DEV_BUY_SOL=2
PUMPFUN_KEYWORDS=
PUMPFUN_MIGRATION_ALERTS=true

# --- EVM chains (Phase 1: ethereum, base, bsc)
EVM_CHAINS=ethereum,base,bsc
# Alert only pairs against WETH/WBNB/USDC/USDT/native.
EVM_QUOTE_PAIRS_ONLY=true
# Optional private RPC endpoints (e.g. Alchemy free tier). Default: free PublicNode endpoints.
EVM_ETHEREUM_WS_URL=
EVM_ETHEREUM_HTTP_URL=
EVM_BASE_WS_URL=
EVM_BASE_HTTP_URL=
EVM_BSC_WS_URL=
EVM_BSC_HTTP_URL=

# --- Wallet trades
# Trades at or above this USD value get a whale badge (and a copy in DISCORD_WEBHOOK_WHALE if set).
WHALE_USD=10000
# Trades below this USD value are stored but not alerted. 0 = alert everything.
MIN_TRADE_USD=0

# --- Solana RPC: wallet tracking (getTransaction) and latency stats.
# The default public endpoint rejects most getTransaction calls ("Too many requests").
# A Helius free key (1M credits/month, 10 req/s) is recommended:
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=
# WebSocket endpoint; derived from SOLANA_RPC_URL (https -> wss) when empty.
SOLANA_WS_URL=
# Follow Solana wallets (true/false). The public RPC cannot keep up with active wallets;
# enable together with a Helius key above.
SOLANA_WALLET_TRACKING=false
# Optional, PAID: PumpPortal serves subscribeAccountTrade (fast Pump.fun wallet trades) only
# to connections with a funded API key. Without it, Solana wallet trades come from the RPC.
PUMPPORTAL_API_KEY=
LATENCY_SAMPLE_RATE=0.25

# --- Storage and logs
DB_PATH=data/radar.db
LOG_DIR=logs
LOG_LEVEL=info
MAX_QUEUE_PER_WEBHOOK=200
